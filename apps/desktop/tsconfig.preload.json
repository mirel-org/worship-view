{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": ".vite/build",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": false,
    "skipLibCheck": true
  },
  "include": ["src/preload/**/*", "src/ipc/**/*.preload.ts", "src/ipc/**/*.types.ts"],
  "exclude": ["node_modules"]
}
